PORT=3847

# Option A — full URI from Atlas (Connect → Drivers → Node)
# MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxx.mongodb.net/?retryWrites=true&w=majority

# Option B — separate fields (avoids special-character issues in the URI)
# MONGODB_USER=your_db_user
# MONGODB_PASSWORD=your_db_password
# MONGODB_HOST=cluster0.xxxx.mongodb.net

MONGODB_DNS_SERVERS=8.8.8.8,1.1.1.1
MONGODB_DB=gym
SYNC_API_KEY=change-me-to-a-long-random-secret

# Defaults (also in ../config/api-defaults.cjs and project root .env):
# BACKEND_URL=https://gym-server-alpha.vercel.app
# SYNC_API_KEY=change-me-to-a-long-random-secret

# Vercel deploy (Project Settings → Environment Variables, Root Directory = server):
# MONGODB_URI (or MONGODB_USER + MONGODB_PASSWORD + MONGODB_HOST), MONGODB_DB, SYNC_API_KEY
# Optional: MONGODB_DNS_SERVERS=8.8.8.8,1.1.1.1
